# Copy this file to `.env` and adjust as needed. `.env` is gitignored.

# --- Ollama (local model runtime) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local chat / reasoning model (pulled separately, not bundled)
LLM_MODEL=qwen3:14b
# Local embedding model
EMBEDDING_MODEL=bge-m3

# --- Backend (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Model context window (tokens). RAG mode only injects retrieved chunks,
# keep this moderate to limit KV cache memory.
NUM_CTX=8192
NUM_PREDICT=1024
MODEL_TIMEOUT_SECONDS=180

# --- Frontend (Vite) ---
FRONTEND_PORT=5173

# --- Local storage paths (relative to project root unless absolute) ---
DATA_DIR=./data
DB_PATH=./data/studio.db
LANCEDB_DIR=./data/lancedb

# --- RAG tuning ---
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=6
